# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible object storage) -- server-only secrets, never
# exposed to the browser. Used by app/api/uploads/presign/route.js to issue
# short-lived presigned upload URLs for restaurant logos, menu item images,
# and profile avatars.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Public base URL the browser can load uploaded files from (the bucket's
# r2.dev dev domain, or a custom domain mapped to the bucket).
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
